{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Celia Task Contract v1",
  "type": "object",
  "required": ["version", "taskId", "definition", "inputs", "successCriteria", "state"],
  "properties": {
    "version": {"const": "1.0"},
    "taskId": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "inputs": {"type": "array"},
    "successCriteria": {"type": "array", "minItems": 1},
    "scope": {"type": "array"},
    "state": {"enum": ["PLANNED", "RUNNING", "BLOCKED", "COMPLETED"]},
    "blocker": {"type": ["string", "null"]}
  }
}
